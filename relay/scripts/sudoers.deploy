# /etc/sudoers.d/deploy — relay VM.
#
# Source: relay/scripts/sudoers.deploy in this repo.
#
# Minimal sudoers for the `deploy` user invoked by dispatch.sh:
# exact verbs, literal paths, no wildcards.
#
# Invariant: NOTHING that arrives on stdin is ever run as root. Every install
# below lands a file that an unprivileged service user runs or reads (app.py
# as `wol`/`pock`, home-watch.sh as `homewatch`, the Caddyfile as `caddy`).
# systemd units are NOT installable from here: a unit is root-equivalent
# (ExecStart, User=, ExecStartPre=+…), so units are installed by the bootstrap
# scripts from a reviewed copy — an admin gesture, never the deploy key
# (scan finding F8, 2026-09-27; guarded by relay/tests/test_deploy_channel_privilege.sh).
#
# Allowed surface:
#   - install the staged app / Caddyfile / window to their runtime destinations
#   - systemctl restart wol-relay / reload caddy
#   - journalctl read-only tail (--no-pager, fixed args, no glob) on the
#     two services this VM runs, for the dispatch.sh logs-* subcommands.
#     wol-relay has 3 pinned depths (100 default / 500 / 3000) because a
#     5-day window is too short to audit usage over time; each depth is a
#     literal case pattern in dispatch.sh, so no free arg reaches sudo.
#     Same unit, same read-only verb — the depth alone grants nothing new.
#
# Note: do NOT add `deploy` to the `sudo` group nor authorise arbitrary
# verbs — the forced-command + minimal sudoers isolation is the whole
# point of this pattern.

Cmnd_Alias WOL_RELAY_INSTALL = \
  /usr/bin/install -o wol -g wol -m 0644 /tmp/wol-relay-staging/app.py /opt/wol-relay/app.py, \
  /usr/bin/install -o wol -g wol -m 0644 /tmp/wol-relay-staging/window /opt/wol-relay/window, \
  /usr/bin/install -m 0644 /tmp/wol-relay-staging/Caddyfile /etc/caddy/Caddyfile

Cmnd_Alias WOL_RELAY_SYSTEMCTL = \
  /bin/systemctl restart wol-relay, \
  /bin/systemctl reload caddy

Cmnd_Alias WOL_RELAY_LOGS = \
  /usr/bin/journalctl -u wol-relay -n 100 --no-pager, \
  /usr/bin/journalctl -u wol-relay -n 500 --no-pager, \
  /usr/bin/journalctl -u wol-relay -n 3000 --no-pager, \
  /usr/bin/journalctl -u caddy -n 100 --no-pager, \
  /usr/bin/journalctl -u caddy -n 500 --no-pager, \
  /usr/bin/journalctl -u caddy -n 3000 --no-pager

# log-footprint — janitorial measurement (knowledge-base ADR
# 2026-07-07-housekeeping-janitorial-autonome §6): journal size + pinned log dirs,
# read-only exact arg vectors, no wildcards.
Cmnd_Alias WOL_RELAY_LOG_FOOTPRINT = \
  /usr/bin/journalctl --disk-usage, \
  /usr/bin/du -shx /var/log /var/lib/caddy

# home-watch — external homelab monitor (apply-home-watch / logs-home-watch).
# Same isolation: exact verbs, literal paths, no wildcards. The units come
# from bootstrap-wol-relay.sh (relay/systemd/home-watch.*).
Cmnd_Alias HOME_WATCH_INSTALL = \
  /usr/bin/install -o homewatch -g homewatch -m 0755 /tmp/wol-relay-staging/home-watch.sh /opt/home-watch/home-watch.sh

Cmnd_Alias HOME_WATCH_SYSTEMCTL = \
  /bin/systemctl enable --now home-watch.timer

Cmnd_Alias HOME_WATCH_LOGS = \
  /usr/bin/journalctl -u home-watch -n 100 --no-pager

# pock-sync — per-app JSON blob store (apply-pock-sync / logs-pock-sync /
# pock-dump). Same isolation: exact verbs, literal paths, no wildcards. The
# unit comes from the pock repo's sync/bootstrap-pock-sync.sh.
# The tar dump is read-only by construction (-cf - to stdout, fixed dir).
Cmnd_Alias POCK_SYNC_INSTALL = \
  /usr/bin/install -o pock -g pock -m 0644 /tmp/wol-relay-staging/pock-sync-app.py /opt/pock-sync/app.py

Cmnd_Alias POCK_SYNC_SYSTEMCTL = \
  /bin/systemctl restart pock-sync

Cmnd_Alias POCK_SYNC_LOGS = \
  /usr/bin/journalctl -u pock-sync -n 100 --no-pager

Cmnd_Alias POCK_SYNC_DUMP = \
  /usr/bin/tar -C /var/lib/pock-sync -cf - .

# tunnel-reap — free the reverse-SSH loopback listener held by a stale
# omvtunnel session (dispatch.sh tunnel-reap). Bounded by construction: the
# -u selector confines the kill to a nologin user that can hold nothing but
# that tunnel, and the home server reconnects on its own restart timer. No
# wildcard: the pattern `sshd` is a literal, so the arg vector is pinned.
# `-f` matches the full command line — the exact form proven live on 2026-08-18;
# the session process shows up as "sshd: omvtunnel@notty", not as a bare comm.
# OS upgrade (route `upgrade`, run by upgrade-run.sh). Pinned word for word:
# no free option can reach apt (a free -o would allow Pre-Invoke hooks = root).
Cmnd_Alias OS_UPGRADE = \
  /usr/bin/apt-get update, \
  /usr/bin/env DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get -y -o DPkg\:\:Lock\:\:Timeout=600 -o Dpkg\:\:Options\:\:=--force-confdef -o Dpkg\:\:Options\:\:=--force-confold dist-upgrade
Cmnd_Alias OMVTUNNEL_REAP = \
  /usr/bin/pkill -u omvtunnel -f sshd

deploy ALL=(root) NOPASSWD: WOL_RELAY_INSTALL, WOL_RELAY_SYSTEMCTL, WOL_RELAY_LOGS, WOL_RELAY_LOG_FOOTPRINT, \
                            HOME_WATCH_INSTALL, HOME_WATCH_SYSTEMCTL, HOME_WATCH_LOGS, \
                            POCK_SYNC_INSTALL, POCK_SYNC_SYSTEMCTL, POCK_SYNC_LOGS, POCK_SYNC_DUMP, \
                            OS_UPGRADE, OMVTUNNEL_REAP
